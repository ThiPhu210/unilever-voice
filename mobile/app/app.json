{
  "expo": {
    "name": "Voice Coach",
    "slug": "unilever-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.unilevervoice",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ghi âm cuộc tư vấn với khách hàng"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.unilevervoice",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Ghi âm cuộc tư vấn với khách hàng"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ghi âm cuộc tư vấn với khách hàng",
          "speechRecognitionPermission": "Nhận dạng giọng nói để tự tạo đơn hàng từ cuộc tư vấn"
        }
      ],
      "expo-secure-store"
    ]
  }
}