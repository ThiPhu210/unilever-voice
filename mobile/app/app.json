{
  "expo": {
    "name": "Voice Coach",
    "slug": "unilever-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.unilevervoice",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ghi âm cuộc tư vấn với khách hàng",
        "NSSpeechRecognitionUsageDescription": "Nhận dạng giọng nói để tự tạo đơn hàng từ cuộc tư vấn",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.unilevervoice",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Ghi âm cuộc tư vấn với khách hàng"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ghi âm cuộc tư vấn với khách hàng",
          "speechRecognitionPermission": "Nhận dạng giọng nói để tự tạo đơn hàng từ cuộc tư vấn"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d1fb4425-e45f-4492-a86c-de0eb1531c38"
      }
    }
  }
}